# ── Required ──────────────────────────────────────────────────────────────
# MySQL / MariaDB connection. On Hostinger: hPanel → Databases → MySQL Databases.
#   mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# If the password has special characters (@ # : / ?), URL-encode them (e.g. @ → %40).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# Session signing secret, 32+ random characters. Generate with:  npx auth secret
AUTH_SECRET=""

# Business timezone for "today", daily and monthly reports
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Required on Hostinger / any server behind a proxy
AUTH_TRUST_HOST=true

# ── First deploy only ─────────────────────────────────────────────────────
# Password for the initial "admin" user (8+ characters). Used only when the
# admin user does not exist yet. Change it after the first login.
SEED_ADMIN_PASSWORD=""

# ── Optional ──────────────────────────────────────────────────────────────
# Enables the email toggles in Settings → Notifications
# SMTP_HOST=""
