# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection (Neon, Supabase, RDS, or your own server). Use SSL in production:
#   postgresql://USER:PASSWORD@HOST:5432/ddsr_movement?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ddsr_movement?schema=public"

# Session signing secret, 32+ characters. Generate with:  npx auth secret
AUTH_SECRET=""

# Business timezone for "today", daily and monthly reports
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Needed when running behind a proxy / on your own server (not on Vercel)
AUTH_TRUST_HOST=true

# ── First-time setup only (used by `npm run db:seed`) ─────────────────────
# Password for the initial "admin" user (8+ characters). Change it after first login.
SEED_ADMIN_PASSWORD=""
# true = also load demo employees/locations and the sample day 06/10/2026
SEED_DEMO=false

# ── Optional ──────────────────────────────────────────────────────────────
# Enables the email toggles in Settings → Notifications
# SMTP_HOST=""
