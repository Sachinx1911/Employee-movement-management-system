// DDSR GROUP — Employee IN / OUT & Movement Management
// All timestamps are stored in UTC (DATETIME(3)). The business date of a
// movement (`date`) is derived from the OUT time in APP_TIMEZONE.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum MovementStatus {
  OUTSIDE
  COMPLETED
  VOID
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  /// Bumped on password change/reset, deactivation or role change; older sessions stop working.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  movementsCreated Movement[] @relation("MovementCreatedBy")
  movementsUpdated Movement[] @relation("MovementUpdatedBy")
  movementsVoided  Movement[] @relation("MovementVoidedBy")
  auditLogs        AuditLog[]
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.DateTime(3)
  updatedAt DateTime   @updatedAt @db.DateTime(3)
  employees Employee[]
}

model Employee {
  id           String      @id @default(cuid())
  name         String
  code         String?     @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  String?
  mobile       String?
  email        String?
  joiningDate  DateTime?   @db.Date
  address      String?     @db.VarChar(300)
  notes        String?     @db.Text
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.DateTime(3)
  updatedAt    DateTime    @updatedAt @db.DateTime(3)
  movements    Movement[]

  @@index([active])
  @@index([departmentId])
}

model Purpose {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?    @db.VarChar(255)
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now()) @db.DateTime(3)
  updatedAt DateTime   @updatedAt @db.DateTime(3)
  movements Movement[]
  locations Location[]
}

model Location {
  id               String     @id @default(cuid())
  name             String     @unique
  area             String?
  city             String?
  defaultPurposeId String?
  defaultPurpose   Purpose?   @relation(fields: [defaultPurposeId], references: [id], onDelete: SetNull)
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @db.DateTime(3)
  movements        Movement[]

  @@index([active])
}

model AuthorizationPerson {
  id          String     @id @default(cuid())
  name        String     @unique
  designation String?
  department  String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now()) @db.DateTime(3)
  updatedAt DateTime   @updatedAt @db.DateTime(3)
  movements Movement[]
}

model Movement {
  id              String               @id @default(cuid())
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Business date (APP_TIMEZONE) of the OUT time.
  date            DateTime             @db.Date
  locationId      String
  location        Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  purposeId       String?
  purpose         Purpose?             @relation(fields: [purposeId], references: [id], onDelete: Restrict)
  authorizedById  String?
  authorizedBy    AuthorizationPerson? @relation(fields: [authorizedById], references: [id], onDelete: Restrict)
  outTime         DateTime             @db.DateTime(3)
  inTime          DateTime?            @db.DateTime(3)
  /// Always computed by the server from inTime - outTime. Never user input.
  durationMinutes Int?
  status          MovementStatus       @default(OUTSIDE)
  /// Equals employeeId while status = OUTSIDE, otherwise NULL.
  /// The unique constraint guarantees one active OUT per employee at DB level.
  activeEmployeeId String?             @unique
  notes           String?  @db.Text

  createdById String
  createdBy   User      @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedById String?
  updatedBy   User?     @relation("MovementUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  voidedById  String?
  voidedBy    User?     @relation("MovementVoidedBy", fields: [voidedById], references: [id])
  voidedAt    DateTime? @db.DateTime(3)
  voidReason  String?   @db.VarChar(255)

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([outTime])
  @@index([inTime])
  @@index([locationId])
  @@index([date, employeeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  /// CREATE | UPDATE | MARK_IN | VOID | ACTIVATE | DEACTIVATE | LOGIN
  action     String
  /// { field: { from, to } } for updates, full snapshot for creates
  changes    Json?
  summary    String?  @db.Text
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

/// Key/value application settings (e.g. WhatsApp report preferences).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

